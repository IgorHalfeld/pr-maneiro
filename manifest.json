{
  "name": "PR Maneiro",
  "version": "1.0",
  "description": "Faça alguém feliz com um comentário no PR!",
  "manifest_version": 3,
  "background": {
    "service_worker": "scripts/background.js"
  },
  "permissions": ["declarativeContent", "storage", "tabs", "activeTab"],
  "action": {
    "default_icon": "icon.png",
    "default_popup": "index.html"
  },
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
